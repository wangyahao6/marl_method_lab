{
  "schema_version": 1,
  "documentation": "DATA.md",
  "path_base": "catalog_directory",
  "join_key": "run_id",
  "csv_empty_value": null,
  "phase_index_base": 0,
  "categories": {
    "comparisons": "方法与基线对照",
    "return-ablations": "回访与阶段干预消融",
    "parameter-ablations": "超参数与组件消融",
    "diagnostics": "机制诊断",
    "behavioral-analysis": "策略行为分析"
  },
  "datasets": {
    "runs": {
      "key": [
        "run_id"
      ],
      "config_path_base": "runs_csv_directory",
      "parent_reference": "parent_run_id",
      "commit_field": "commit",
      "step_unit": "environment_steps"
    },
    "evaluations": {
      "key": [
        "run_id",
        "phase",
        "task",
        "label",
        "t_env"
      ],
      "win_rate_numerator": "wins",
      "win_rate_denominator": "episodes",
      "step_field": "t_env",
      "labels": {
        "initial_reference": "初始模型评估",
        "next_unseen": "首次训练目标任务前评估",
        "phase_start": "本阶段开始时评估当前任务",
        "periodic": "本阶段定期评估当前任务",
        "stage_end": "阶段末评估已见任务"
      }
    },
    "stage_metrics": {
      "key": [
        "run_id",
        "phase"
      ],
      "derived_from": "evaluations",
      "units": {
        "*_win_pct": "percent",
        "acc_pct": "percent",
        "bwt_pp": "percentage_points",
        "fwt_pp": "percentage_points",
        "return_auc_pct": "percent"
      }
    },
    "preference_diagnostics": {
      "key": [
        "run_id",
        "phase",
        "source_phase",
        "historical_task"
      ],
      "coverage_numerator": "valid_states",
      "coverage_denominator": "decision_states",
      "sampling_unit": "replayed agent decisions with repeated samples"
    }
  },
  "experiments": [
    {
      "id": "szc-vdn64",
      "category": "comparisons",
      "report": "comparisons/szc-vdn64/README.md",
      "files": {
        "runs": "comparisons/szc-vdn64/runs.csv",
        "stage_metrics": "comparisons/szc-vdn64/stage_metrics.csv",
        "evaluations": "comparisons/szc-vdn64/evaluations.csv",
        "preference_diagnostics": "comparisons/szc-vdn64/preference_diagnostics.csv",
        "chi_selection": "comparisons/szc-vdn64/chi_selection.json",
        "paired_final": "comparisons/szc-vdn64/paired_final.csv",
        "gradient_diagnostics": "comparisons/szc-vdn64/gradient_diagnostics.csv",
        "effective_k_histogram": "comparisons/szc-vdn64/effective_k_histogram.csv",
        "replay_samples": "comparisons/szc-vdn64/replay_samples.csv"
      },
      "task_order": [
        "stalker",
        "zealot",
        "colossus"
      ],
      "training_seeds": [
        1111,
        2222,
        3535
      ],
      "final_phase": 2,
      "comparison": {
        "kind": "independent_runs_matched_by_seed",
        "match_on": [
          "seed"
        ],
        "primary_control": {
          "method": "VDN-FT",
          "role": "independent"
        },
        "additional_control": {
          "method": "VDN-ER",
          "role": "independent"
        },
        "matched_contrasts": {
          "file": "paired_final",
          "control_join_key": "control_run_id"
        }
      },
      "interpretation_limits": [
        "只覆盖一个任务顺序与双层 VDN64。不同方法覆盖的训练种子不同。评估局数用于估计单次运行的表现。",
        "归档方法标签 ASPR 和标识 action_set_preference 对应 ASPR-Max。本表未收录新版 aspr_preference。",
        "VDN-ER 与 VDN-ER+CHI 使用按任务平衡的 TD 回放。其余 SZC 组使用逐阶段清空或重建 TD 池。所有组按任务重启 ε。",
        "CHI 与现有 VDN-FT/ER 基线使用不同驱动。定期曲线使用实际 t_env。",
        "Raw/RawLoss 对原版 FRPR 的同种子比较沿用历史运行，代码与旧 Q 存储的差异见报告及 runs.csv。",
        "TKPR K 值专页与本表复用五条相同 run_id。同一次训练只计一次。"
      ]
    },
